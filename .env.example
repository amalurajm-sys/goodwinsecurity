# Copy to .env and fill in. Never commit .env.

# Public site URL (used for canonical links, sitemap and emails)
SITE_URL=https://goodwinsecuritybh.com

# Required: long random string for signing admin sessions.
# Generate with:  openssl rand -base64 48
SESSION_SECRET=

# First admin account — created automatically on first start when no users exist.
# Remove ADMIN_PASSWORD from this file after the first successful login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email delivery for new enquiries (optional; without it enquiries are only stored in the admin panel)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address, e.g. "GOODWIN SECURITY Website <noreply@goodwinsecuritybh.com>"
SMTP_FROM=
# Where enquiry notifications go (can also be set in Admin → Company & homepage)
ENQUIRY_NOTIFY_EMAIL=

# Host port the container listens on (nginx proxies to it)
GOODWIN_PORT=3010

# Only for local testing over plain http — never in production
# INSECURE_COOKIES=true
